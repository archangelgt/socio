{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_SECRET",
    "TOKEN_ENCRYPTION_KEY",
    "API_HOST",
    "API_PORT",
    "WEB_ORIGIN",
    "AI_PROVIDER",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_BASE_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
